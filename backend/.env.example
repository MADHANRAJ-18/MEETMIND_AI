# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env to git.

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY     # Settings → API → service_role
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY        # Settings → API → anon/public
# Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# --- Google Calendar API ------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Frontend -----------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:5500

# --- LLM (Groq recommended) ---------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (Gmail SMTP) -------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=YOUR_EMAIL@gmail.com
SMTP_USE_TLS=true

# --- Server -------------------------------------------------------------
PORT=5000
FLASK_ENV=development
